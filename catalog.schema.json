{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nanos.invalid/schemas/nanoapp-catalog-v1.schema.json",
  "title": "SeedOS Store catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "generated_at", "apps"],
  "properties": {
    "schema": { "const": "nanos.store.catalog" },
    "schema_version": { "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "apps": {
      "type": "array",
      "maxItems": 24,
      "items": { "$ref": "#/$defs/app" }
    }
  },
  "$defs": {
    "capability": {
      "enum": ["network", "storage", "audio", "sensor", "notifications", "peer"]
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "summary", "version", "min_api", "runtime", "capabilities", "package"],
      "allOf": [{
        "if": {"properties": {"capabilities": {"contains": {"const": "peer"}}}},
        "then": {"properties": {"min_api": {"minimum": 4}}}
      }],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9._-]{1,39}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 31 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 96 },
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,4})\\.(0|[1-9][0-9]{0,4})\\.(0|[1-9][0-9]{0,4})$" },
        "min_api": { "type": "integer", "minimum": 1 },
        "runtime": { "const": "lua" },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/capability" }
        },
        "package": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "size", "sha256", "signature_algorithm", "key_id"],
          "properties": {
            "url": { "type": "string", "maxLength": 192, "pattern": "^https://[^?#@]+$" },
            "size": { "type": "integer", "minimum": 97, "maximum": 262144 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "signature_algorithm": { "const": "ecdsa-p256-sha256" },
            "key_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,39}$" }
          }
        }
      }
    }
  }
}
